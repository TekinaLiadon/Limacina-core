# Скопируйте в .env и замените значения.
# JWT_ACCESS и JWT_REFRESH обязательны и должны быть не короче 32 символов,
# иначе старт упадёт на валидации. Сгенерировать: openssl rand -hex 32

# окружение: development | test | production
NODE_ENV=development

# замените на случайную строку минимум 32 символа
JWT_ACCESS=change-me-access-secret

# замените на случайную строку минимум 32 символа
JWT_REFRESH=change-me-refresh-secret

# порт сервера (по умолчанию 3005)
PORT=3005

# уровень логирования (по умолчанию info): trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# публичный базовый URL (по умолчанию http://localhost:3005)
# используется в ссылках на текстуры и метаданных Yggdrasil
BASE_URL=http://localhost:3005

# бэкенд хранения (по умолчанию map): map | postgres | mariadb
# map разрешён только в development/test. В production старт с map запрещён.
# Миграции в репозитории postgres-only: новую MariaDB-базу ими не создать,
# для нового окружения используйте postgres.
DB_DRIVER=map

# строка подключения — обязательна для DB_DRIVER=postgres / mariadb
# держите её в .env или реальном окружении: CLI миграций и rebuild-конвейер
# не читают DATABASE_URL из SECRETS
# DATABASE_URL=postgres://user:password@localhost:5432/limacina

# URL Redis-сервера для кеша и rate limit (по умолчанию in-memory)
# REDIS_URL=redis://localhost:6379

# префикс ключей в Redis (по умолчанию limacina:<NODE_ENV>)
# CACHE_PREFIX=limacina:production

# абсолютный путь к каталогу ключей подписи текстур Yggdrasil (по умолчанию ./keys)
# KEYS_DIR=/opt/limacina/keys

# URL прокси-сервера для обычной авторизации (не реализовано — не задавать)
# AUTH_PROXY_URL=https://auth.example.com

# мастер-пароль — вход под любым пользователем
# MASTER_PASSWORD=your-master-password

# цель пинга игрового сервера для /v1/common/status: host | host:port | [ipv6]:port (порт по умолчанию 25565)
# MINECRAFT_HOST=mc.example.com:25565

# RCON-консоль игрового сервера (/v1/panel/server/rcon*, owner-only): host + пароль обязательны вместе
# RCON_HOST=mc.example.com
# RCON_PORT=25575
# RCON_PASSWORD=your-rcon-password

# закреплённая ревизия деплоя для rebuild-конвейера (полный 40-символьный git SHA)
# DEPLOY_PINNED_REVISION=0000000000000000000000000000000000000000

# лимит попыток входа на username за окно (по умолчанию 10)
# RATE_LIMIT_AUTH_MAX=10

# IP-бакет auth-маршрутов, работает вместе с username-бакетом (по умолчанию 10)
# RATE_LIMIT_AUTH_IP_MAX=10

# окно auth-лимита в миллисекундах (по умолчанию 60000)
# RATE_LIMIT_AUTH_WINDOW=60000

# глобальный лимит запросов с одного IP (по умолчанию 600 за 60000 мс)
# RATE_LIMIT_GLOBAL_MAX=600
# RATE_LIMIT_GLOBAL_WINDOW=60000

# деплой за reverse-proxy: true — клиентский IP берётся из X-Forwarded-For
# прямые подключения без прокси: false, иначе IP можно подделать заголовком
# BEHIND_PROXY=true

# адрес/подсеть доверенного прокси; без значения доверяются все.
# задан при BEHIND_PROXY=false — старт упадёт
# TRUST_PROXY=127.0.0.1

# лимиты загрузки контента на пользователя (по умолчанию 1)
# MAX_SKINS_PER_USER=1
# MAX_MODELS_PER_USER=1
# MAX_CAPES_PER_USER=1

# разрешённые CORS origins через запятую (без переменной CORS закрыт)
# CORS_ORIGINS=https://panel.example.com,https://launcher.example.com

# секреты одним JSON-значением, ключи мергятся в env при старте
# читает только приложение: CLI миграций и rebuild-шаги SECRETS не видят
# SECRETS={"JWT_ACCESS":"...","JWT_REFRESH":"..."}
