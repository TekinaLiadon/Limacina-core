# ============================================================
# Limacina-core — переменные окружения
#
# Скопируйте файл и заполните:  cp .env.example .env
# Bun подхватывает .env из рабочей директории автоматически
# (в т.ч. скомпилированный бинарник dist/Limacina).
# ============================================================

# --- Обязательные ---

# окружение: development | production
NODE_ENV=development

# секрет для подписи JWT access-токенов
# сгенерируйте свой, например: openssl rand -hex 32
JWT_ACCESS=your-access-secret

# секрет для подписи JWT refresh-токенов (отличный от JWT_ACCESS)
JWT_REFRESH=your-refresh-secret

# --- Приложение (опциональные) ---

# порт сервера (по умолчанию 3005)
PORT=3005

# уровень логирования: info | debug (по умолчанию info)
LOG_LEVEL=info

# публичный базовый URL — от него зависят ссылки на текстуры и файлы
# (по умолчанию http://localhost:3005). В продакшене укажите свой домен.
BASE_URL=http://localhost:3005

# --- База данных (опциональные) ---

# бэкенд хранения (по умолчанию map):
#   map      — в памяти, без внешних зависимостей; ТОЛЬКО для разработки
#              (данные теряются при перезапуске; в production конфиг отклонит map)
#   postgres — PostgreSQL (продакшен; выполните миграции:
#              bun run migrate:install && bun run migrate:up)
DB_DRIVER=map

# строка подключения — только для DB_DRIVER=postgres
# DATABASE_URL=postgres://user:password@localhost:5432/limacina

# --- Прочее (опциональные) ---

# абсолютный путь к каталогу ключей подписи текстур Yggdrasil (keys/)
# по умолчанию: ./keys от рабочей директории (важно для скомпилированного dist/Limacina)
# KEYS_DIR=/opt/limacina/keys

# URL прокси для Yggdrasil API
# YGGDRASIL_PROXY_URL=https://proxy.example.com

# мастер-пароль — позволяет войти под любым пользователем без знания его пароля
# MASTER_PASSWORD=your-master-password

# --- Rate limiting (опциональные) ---

# лимит попыток входа на username за окно (по умолчанию 10)
# действует на /v1/common/auth/login, /v1/common/auth/registration и легаси-аналоги
# RATE_LIMIT_AUTH_MAX=10

# окно rate limit в миллисекундах (по умолчанию 60000 = 1 минута)
# RATE_LIMIT_AUTH_WINDOW=60000

# --- Проксирование (опциональные) ---

# адрес/подсеть доверенного прокси для определения реального IP клиента
# (X-Forwarded-For). Пусто — не доверять никому (прямые подключения).
# Указывайте только адрес ВАШЕГО nginx/прокси, например:
# TRUST_PROXY=127.0.0.1
# TRUST_PROXY=10.0.0.0/8

# лимиты загрузки контента на пользователя (по умолчанию 1)
# MAX_SKINS_PER_USER=1
# MAX_MODELS_PER_USER=1

# разрешённые CORS origins через запятую (если не задано — разрешены любые)
# нужно, если панель или лаунчер обращаются к API с другого домена
# CORS_ORIGINS=https://panel.example.com,https://launcher.example.com

# --- Секреты одним значением (опционально) ---

# SECRETS — JSON-объект, ключи которого мергятся в env при старте
# (удобно для передачи секретов в контейнерах вместо .env)
# SECRETS={"JWT_ACCESS":"...","JWT_REFRESH":"..."}
