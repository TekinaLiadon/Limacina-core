# окружение: development | test | production
NODE_ENV=development

# секрет для подписи JWT access-токенов
JWT_ACCESS=your-access-secret

# секрет для подписи JWT refresh-токенов
JWT_REFRESH=your-refresh-secret

# порт сервера (по умолчанию 3005)
PORT=3005

# уровень логирования (по умолчанию info): trace | debug | info | warn | error | fatal | silent
LOG_LEVEL=info

# публичный базовый URL (по умолчанию http://localhost:3005)
BASE_URL=http://localhost:3005

# бэкенд хранения (по умолчанию map): map | postgres | mariadb
DB_DRIVER=map

# строка подключения — для DB_DRIVER=postgres / mariadb
# DATABASE_URL=postgres://user:password@localhost:5432/limacina

# URL Redis-сервера для кеша (по умолчанию in-memory)
# REDIS_URL=redis://localhost:6379

# префикс ключей в Redis (по умолчанию limacina:<NODE_ENV>)
# CACHE_PREFIX=limacina:production

# абсолютный путь к каталогу ключей подписи текстур Yggdrasil (по умолчанию ./keys)
# KEYS_DIR=/opt/limacina/keys

# URL прокси-сервера для обычной авторизации (не реализовано — не задавать)
# AUTH_PROXY_URL=https://auth.example.com

# мастер-пароль — вход под любым пользователем
# MASTER_PASSWORD=your-master-password

# цель пинга игрового сервера для /v1/common/status: host | host:port | [ipv6]:port (порт по умолчанию 25565)
# MINECRAFT_HOST=mc.example.com:25565

# закреплённая ревизия деплоя для rebuild-конвейера (полный 40-символьный git SHA)
# DEPLOY_PINNED_REVISION=0000000000000000000000000000000000000000

# лимит попыток входа на username за окно (по умолчанию 10)
# RATE_LIMIT_AUTH_MAX=10

# окно rate limit в миллисекундах (по умолчанию 60000)
# RATE_LIMIT_AUTH_WINDOW=60000

# адрес/подсеть доверенного прокси для X-Forwarded-For
# TRUST_PROXY=127.0.0.1

# лимиты загрузки контента на пользователя (по умолчанию 1)
# MAX_SKINS_PER_USER=1
# MAX_MODELS_PER_USER=1
# MAX_CAPES_PER_USER=1

# разрешённые CORS origins через запятую
# CORS_ORIGINS=https://panel.example.com,https://launcher.example.com

# секреты одним JSON-значением, ключи мергятся в env при старте
# SECRETS={"JWT_ACCESS":"...","JWT_REFRESH":"..."}
